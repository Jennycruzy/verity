# Verity local configuration
#
# Copy this file to .env and fill only the blank values. Never commit .env.
# Use Hedera Testnet while developing. Do not use a mainnet account or key.

# Blocky402 hosted testnet facilitator. Testnet does not require an API key.
BLOCKY402_URL=https://api.testnet.blocky402.com

# Hedera payment settings.
HEDERA_NETWORK=hedera:testnet
# Native HBAR. Keep this as 0.0.0 for the first live run.
HEDERA_ASSET_ID=0.0.0

# Buyer/operator account. The private key stays local and must never be committed.
# The account needs testnet HBAR for payments and HCS publication.
HEDERA_CLIENT_ACCOUNT_ID=
HEDERA_CLIENT_PRIVATE_KEY=

# Provider treasury account. This public account receives the payment.
HEDERA_PAY_TO_ACCOUNT_ID=

# Read-only Hedera services.
MIRROR_NODE_BASE_URL=https://testnet.mirrornode.hedera.com/api/v1
HASHSCAN_BASE_URL=https://hashscan.io/testnet

# Created on Hedera by the provisioning command. Do not invent these values.
HCS_SETTLEMENT_TOPIC_ID=
HCS_DISPUTE_TOPIC_ID=

# Required only by the replay command after the content service is deployed.
# The service must return content by SHA-256 path or by the recorded URI.
CONTENT_STORE_BASE_URL=

# Required only when the bonded dispute service is running.
VERITY_DISPUTE_URL=

# Network request timeout in milliseconds.
BLOCKY402_TIMEOUT_MS=10000

# Required only for scripts/measure-hold-window.ts.
# Amounts are strings in the smallest unit of HEDERA_ASSET_ID (tinybar for HBAR).
# The measurement can settle more than one attempt, so use a funded buyer account.
HOLD_WINDOW_AMOUNT=
HOLD_WINDOW_PAY_TO=
HOLD_WINDOW_RESOURCE_URL=
HOLD_WINDOW_MAX_DELAY_SECONDS=
HOLD_WINDOW_PAYMENT_TIMEOUT_SECONDS=
HOLD_WINDOW_SAFETY_MARGIN_SECONDS=

# Required only for scripts/demo.ts.
VERITY_DEMO_PROVIDER_URL=
VERITY_DEMO_RULE=fx-rate-v1
VERITY_DEMO_PROVIDER_ID=
VERITY_DEMO_BUYER_ROOT=
VERITY_DEMO_MAX_PRICE=
VERITY_DEMO_BOND=
VERITY_DEMO_EXPECTED_FX_RATE=
VERITY_DEMO_FX_TOLERANCE_BPS=
VERITY_DEMO_EXPECTED_ENTITY=

# Explorer and hosted Graph configuration.
# These are not needed for the first Hedera payment demo.
EXPLORER_PORT=8787
GRAPH_SUBGRAPH_URL=
GRAPH_API_KEY=
GRAPH_PROVIDER_QUERY_FILE=
GRAPH_BUYER_QUERY_FILE=

# Escrow deployment. Compile first with npm run contracts:build.
VERITY_ESCROW_ARTIFACT_PATH=artifacts/forge/VerityBondEscrow.sol/VerityBondEscrow.json
VERITY_ESCROW_MINIMUM_BOND=
VERITY_ESCROW_GAS=
VERITY_ESCROW_CONTRACT_ID=
