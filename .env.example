# Verity local configuration
#
# Copy this file to .env and fill only the blank values. Never commit .env.
# Use Hedera Testnet while developing. Do not use a mainnet account or key.
VERITY_DOMAIN=

# Blocky402 hosted testnet facilitator. Testnet does not require an API key.
BLOCKY402_URL=https://api.testnet.blocky402.com

# Hedera payment settings.
HEDERA_NETWORK=hedera:testnet
# Native HBAR. Keep this as 0.0.0 for the first live run.
HEDERA_ASSET_ID=0.0.0
# Bond and provider stake asset. The escrow contract currently accepts HBAR.
VERITY_BOND_ASSET_ID=0.0.0
# Optional. With a positive value, the buyer uses postBondWithExpiry and
# schedules releaseExpiredBond through Hedera Scheduled Transactions.
VERITY_BOND_EXPIRY_SECONDS=

# Optional HTS settlement asset. Leave HEDERA_ASSET_ID at 0.0.0 until
# `npm run provision:token` creates the token and writes its ID here.
HEDERA_TOKEN_TREASURY_ACCOUNT_ID=
HEDERA_TOKEN_TREASURY_PRIVATE_KEY=
HEDERA_TOKEN_NAME=
HEDERA_TOKEN_SYMBOL=
HEDERA_TOKEN_DECIMALS=
HEDERA_TOKEN_INITIAL_SUPPLY=
HEDERA_TOKEN_FEE_COLLECTOR_ACCOUNT_ID=
HEDERA_TOKEN_FEE_AMOUNT=
HEDERA_TOKEN_MEMO=verity/settlement-token/v1
# JSON array of {"accountId":"0.0.N","privateKey":"..."} credentials.
HEDERA_TOKEN_ASSOCIATIONS_JSON=
# JSON array of {"accountId":"0.0.N","amount":"..."} initial transfers.
HEDERA_TOKEN_DISTRIBUTIONS_JSON=

# Buyer/operator account. The private key stays local and must never be committed.
# The account needs testnet HBAR for payments and HCS publication.
HEDERA_CLIENT_ACCOUNT_ID=
HEDERA_CLIENT_PRIVATE_KEY=
# Optional for bonded disputes; the SDK derives it from the ECDSA key when blank.
HEDERA_CLIENT_EVM_ADDRESS=

# Used only by `npm run provision:accounts` to create the provider staking and
# payout accounts from the funded buyer account. Choose the balance explicitly.
HEDERA_ACCOUNT_INITIAL_BALANCE_HBAR=

# Provider account used only by stake:provider. The account helper funds it
# during creation; manual setup must fund it separately.
HEDERA_PROVIDER_ACCOUNT_ID=
HEDERA_PROVIDER_PRIVATE_KEY=
HEDERA_PROVIDER_EVM_ADDRESS=

# Provider treasury account. This public account receives the payment.
HEDERA_PAY_TO_ACCOUNT_ID=

# Reference provider process. Override PORT and PROVIDER_KIND per process when
# running more than one provider or checker from the same checkout.
PROVIDER_KIND=fx
PORT=8080
DEGRADE_MODE=false
DEGRADED_FX_RATE=
FX_PRICE=
FX_PAIR=EUR/USD
FX_REFERENCE_RATE=
FX_TOLERANCE_BPS=
ENTITY_CACHED_PRICE=
ENTITY_FRESH_PRICE=

# Read-only Hedera services.
MIRROR_NODE_BASE_URL=https://testnet.mirrornode.hedera.com/api/v1
HASHSCAN_BASE_URL=https://hashscan.io/testnet

# Created on Hedera by the provisioning command. Do not invent these values.
HCS_SETTLEMENT_TOPIC_ID=
HCS_DISPUTE_TOPIC_ID=

# Required only by the replay command after the content service is deployed.
# The service must return content by SHA-256 path or by the recorded URI.
CONTENT_STORE_BASE_URL=

# File-backed content service used by dispute uploads and replay.
CONTENT_STORE_PORT=8090
CONTENT_STORE_DIR=artifacts/content
CONTENT_STORE_PUBLIC_URL=
CONTENT_STORE_MAX_BYTES=262144

# Dispute service. All checker and World ID URLs are supplied by the operator.
DISPUTE_PORT=8091
DISPUTE_STORE_DIR=artifacts/disputes
DISPUTE_MAX_BODY_BYTES=65536
DISPUTE_CHECKER_TIMEOUT_MS=10000
DISPUTE_CHECKERS_JSON=
# Separate Go FX checker. Set these before `npm run checker:go`.
CHECKER_PORT=
CHECKER_ID=
CHECKER_MAX_BODY_BYTES=65536
VERITY_ROOT_STORE_PATH=artifacts/identity-roots.json
VERITY_PROVIDER_REGISTRY_FILE=artifacts/providers.json
VERITY_PROVIDER_ID=
VERITY_PROVIDER_ROOT=
VERITY_PROVIDER_STAKE=
VERITY_PROVIDER_ROOT_STORE_PATH=artifacts/provider-roots.json
VERITY_PROVIDER_IDENTITY_PROOF_JSON=
VERITY_PROVIDER_IDENTITY_SIGNAL=
VERITY_PROVIDER_PUBLIC_URL=
# ERC-8004 uses an EVM JSON-RPC endpoint. The registry reference must match
# the RPC chain, for example eip155:<chainId>:<identity-registry-address>.
VERITY_ERC8004_REGISTRY=
VERITY_ERC8004_AGENT_ID=
VERITY_ERC8004_RPC_URL=
# Optional external URI. If blank, register:erc8004 writes a self-contained
# data URI containing the standard registration file.
VERITY_ERC8004_AGENT_URI=
VERITY_ERC8004_REGISTRATION_TX=
VERITY_ERC8004_AGENT_URI_TX=
VERITY_PROVIDER_AGENT_REGISTRATION_TX=
WORLD_ID_VERIFY_URL=
WORLD_ID_DISPUTE_ACTION=
WORLD_ID_PORT=8093
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_SIGNING_KEY=
WORLD_ID_ALLOWED_ACTIONS=verity-provider-registration,verity-dispute

# Required only when the bonded dispute service is running.
VERITY_DISPUTE_URL=
VERITY_DISPUTE_HEALTH_URL=

# Network request timeout in milliseconds.
BLOCKY402_TIMEOUT_MS=10000

# Required only for scripts/measure-hold-window.ts.
# Amounts are strings in the smallest unit of HEDERA_ASSET_ID (tinybar for HBAR).
# The measurement can settle more than one attempt, so use a funded buyer account.
HOLD_WINDOW_AMOUNT=
HOLD_WINDOW_PAY_TO=
HOLD_WINDOW_RESOURCE_URL=
HOLD_WINDOW_MAX_DELAY_SECONDS=
HOLD_WINDOW_PAYMENT_TIMEOUT_SECONDS=
HOLD_WINDOW_SAFETY_MARGIN_SECONDS=

# Required only for scripts/demo.ts.
VERITY_DEMO_PROVIDER_URL=
VERITY_DEMO_BAD_PROVIDER_URL=
VERITY_DEMO_BAD_PROVIDER_ID=
VERITY_DEMO_REFERENCE_PROVIDER_URLS=
VERITY_DEMO_RULE=fx-rate-v1
VERITY_DEMO_PROVIDER_ID=
VERITY_DEMO_BUYER_ROOT=
VERITY_DEMO_PROVIDER_ROOT=
VERITY_DEMO_MAX_PRICE=
VERITY_DEMO_BOND=
VERITY_DEMO_IDENTITY_PROOF_JSON=
VERITY_DEMO_IDENTITY_SIGNAL=
VERITY_DEMO_PROVIDER_RESPONSES_JSON=
VERITY_DEMO_EXPECTED_FX_RATE=
VERITY_DEMO_FX_TOLERANCE_BPS=
VERITY_DEMO_EXPECTED_ENTITY=

# Explorer and hosted Graph configuration.
# These are not needed for the first Hedera payment demo.
EXPLORER_PORT=8787
GRAPH_SUBGRAPH_URL=
GRAPH_API_KEY=
GRAPH_GATEWAY_PORT=8092
GRAPH_GATEWAY_PRICE=
GRAPH_GATEWAY_MAX_BODY_BYTES=65536
GRAPH_GATEWAY_TIMEOUT_MS=10000
GRAPH_GATEWAY_UPSTREAM_API_KEY=
GRAPH_MAX_PRICE=
GRAPH_MIN_RELIABILITY=0.8
GRAPH_PROVIDER_QUERY_FILE=
GRAPH_BUYER_QUERY_FILE=
GRAPH_ROUTE_CANDIDATES_JSON=
GRAPH_SUBGRAPH_NETWORK=
GRAPH_SUBSTREAM_START_BLOCK=
GRAPH_STUDIO_SUBGRAPH=
GRAPH_STUDIO_DEPLOY_KEY=
GRAPH_STUDIO_VERSION_LABEL=
# Optional live Agent0 feedback publisher. Use a Graph-supported EVM testnet
# (for example Base Sepolia or Ethereum Sepolia), not the Hedera registry.
GRAPH_FEEDBACK_RPC_URL=
GRAPH_FEEDBACK_IDENTITY_REGISTRY=
GRAPH_FEEDBACK_REPUTATION_REGISTRY=
GRAPH_FEEDBACK_PROVIDER_AGENT_ID=
GRAPH_FEEDBACK_BUYER_AGENT_ID=
GRAPH_FEEDBACK_BUYER_PRIVATE_KEY=
GRAPH_FEEDBACK_PROVIDER_PRIVATE_KEY=
GRAPH_FEEDBACK_PROVIDER_ENDPOINT=
GRAPH_FEEDBACK_BUYER_ENDPOINT=
GRAPH_FEEDBACK_PROVIDER_REGISTRATION_TX=
GRAPH_FEEDBACK_PROVIDER_AGENT_URI=
GRAPH_FEEDBACK_PROVIDER_AGENT_URI_TX=
GRAPH_FEEDBACK_BUYER_REGISTRATION_TX=
GRAPH_FEEDBACK_BUYER_AGENT_URI=
GRAPH_FEEDBACK_BUYER_AGENT_URI_TX=

# Escrow deployment. Compile first with npm run contracts:build.
VERITY_ESCROW_ARTIFACT_PATH=artifacts/forge/VerityBondEscrow.sol/VerityBondEscrow.json
VERITY_ESCROW_MINIMUM_BOND=
VERITY_ESCROW_GAS=
# Maximum fee budget for the multi-transaction bytecode upload during deployment.
VERITY_ESCROW_DEPLOY_MAX_FEE_HBAR=
VERITY_ESCROW_CONTRACT_ID=
