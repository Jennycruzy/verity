{
  "name": "verity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm --workspace @jennycruzy/verity run build",
    "test": "npm run build && npm run test:workspaces",
    "test:workspaces": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b",
    "discover": "tsx scripts/discover-capabilities.ts",
    "check:config": "tsx scripts/check-config.ts",
    "graph:mcp": "tsx scripts/verity-mcp.ts",
    "graph:route": "tsx scripts/route-demo.ts",
    "graph:check-signers": "tsx scripts/check-graph-signers.ts",
    "graph:check-hosted": "tsx scripts/check-graph-hosted.ts",
    "public:check": "tsx scripts/public-smoke.ts",
    "provision:accounts": "tsx scripts/provision-accounts.ts",
    "provision:topics": "tsx scripts/provision-topics.ts",
    "provision:token": "tsx scripts/provision-token.ts",
    "register:provider": "tsx scripts/register-provider.ts",
    "register:erc8004": "tsx scripts/register-erc8004.ts",
    "register:graph-agent": "tsx scripts/register-graph-agent.ts",
    "provision:graph-signers": "node --import tsx scripts/provision-graph-signers.ts",
    "register:agent": "tsx scripts/register-agent.ts",
    "publish:agent0-feedback": "tsx scripts/publish-agent0-feedback.ts",
    "graph:prepare": "npm run build && tsx scripts/prepare-graph.ts",
    "graph:build": "npm run graph:prepare && npm --prefix graph/subgraph run build",
    "graph:deploy": "npm run graph:build && tsx scripts/deploy-graph.ts",
    "graph:gateway": "npm --workspace @verity/graph-gateway start",
    "public:start": "tsx scripts/public-ingress.ts",
    "stake:provider": "tsx scripts/stake-provider.ts",
    "content:start": "npm --workspace @verity/content-service start",
    "disputes:start": "npm --workspace @verity/disputes start",
    "checker:go": "go -C services/checker-go run .",
    "contracts:build": "forge build --offline",
    "contracts:deploy": "tsx scripts/deploy-escrow.ts",
    "measure-hold": "tsx scripts/measure-hold-window.ts",
    "demo": "tsx scripts/demo.ts",
    "dispute:demo": "tsx scripts/dispute-demo.ts",
    "contracts:test": "forge test --offline"
  },
  "dependencies": {
    "@x402/core": "2.25.0",
    "@x402/hedera": "2.25.0",
    "dotenv": "^16.4.7",
    "ethers": "6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
