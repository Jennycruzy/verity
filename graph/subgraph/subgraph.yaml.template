specVersion: 1.0.0
description: Verity reputation records indexed through Agent0-compatible ERC-8004 entities.
repository: https://github.com/Jennycruzy/verity
indexerHints:
  prune: auto
schema:
  file: ./schema.graphql

dataSources:
  - kind: substreams
    name: agent0Identity
    network: ${GRAPH_SUBGRAPH_NETWORK}
    source:
      package:
        moduleName: identity_events
        file: ../substreams/build/verity-agent-feedback-v0.1.0.spkg
    mapping:
      apiVersion: 0.0.7
      kind: substreams/graph-entities
      file: ./src/mapping.ts
      handler: handleIdentityEvents

  - kind: substreams
    name: agent0Feedback
    network: ${GRAPH_SUBGRAPH_NETWORK}
    source:
      package:
        moduleName: feedback_events
        file: ../substreams/build/verity-agent-feedback-v0.1.0.spkg
    mapping:
      apiVersion: 0.0.7
      kind: substreams/graph-entities
      file: ./src/mapping.ts
      handler: handleFeedbackEvents

  - kind: substreams
    name: agent0FeedbackRevocations
    network: ${GRAPH_SUBGRAPH_NETWORK}
    source:
      package:
        moduleName: feedback_revocations
        file: ../substreams/build/verity-agent-feedback-v0.1.0.spkg
    mapping:
      apiVersion: 0.0.7
      kind: substreams/graph-entities
      file: ./src/mapping.ts
      handler: handleRevocationEvents
